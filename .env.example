# Copy this file to backend/.env and fill in real values.
# Required — Jarvis will refuse to start without these.
GROQ_API_KEY=
VTOP_USERNAME=
VTOP_PASSWORD=
LMS_USERNAME=
LMS_PASSWORD=
MY_WHATSAPP_NUMBER=

# Optional — referenced in config.py but not used by any active feature yet.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
OPENWEATHER_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PORCUPINE_API_KEY=

# Optional — focus mode distraction control. FOCUS_KILL_MODE is 'mute'
# (default, safer) or 'kill'. FOCUS_KILL_APPS is a comma-separated list
# of process names, only used when FOCUS_KILL_MODE=kill.
FOCUS_KILL_MODE=mute
FOCUS_KILL_APPS=Discord.exe,Spotify.exe

# Optional — expense tracker. EXPENSE_AUTO_INGEST controls whether a
# successfully-parsed WhatsApp UPI message gets logged automatically
# (true, default) or just detected and held for voice confirmation (false).
EXPENSE_AUTO_INGEST=true

# Optional — read by whatsapp_service/server.js (Node), not the Python
# backend. UPI_SENDER_PATTERNS is a comma-separated list of WhatsApp
# display-name substrings to watch for; replace with your actual bank/UPI
# app's WhatsApp name for real accuracy.
JARVIS_BACKEND_URL=http://localhost:8000
UPI_SENDER_PATTERNS=HDFC Bank,SBI,ICICI Bank,Axis Bank,Paytm,PhonePe,Google Pay
