# Easiest: run `python setup.py` — it writes backend/.env for you.
# Or copy this file to backend/.env and fill it in by hand.

# Required — free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional — VIT students: VTOP (attendance, marks, exams, timetable) and
# LMS (assignments). Leave empty and those features simply stay off.
VTOP_USERNAME=
VTOP_PASSWORD=
LMS_USERNAME=
LMS_PASSWORD=

# Optional — WhatsApp morning brief / reminders (number with country code).
MY_WHATSAPP_NUMBER=

# Optional — backup brain when Groq's free limits run out
# (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional — referenced in config.py but not used by any active feature yet.
ELEVENLABS_API_KEY=
OPENWEATHER_API_KEY=
PORCUPINE_API_KEY=

# Optional — Spotify Web API for exact search-and-play (https://developer.spotify.com/dashboard,
# redirect URI http://127.0.0.1:8888/callback). Without it, Jarvis drives the Spotify app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — focus mode distraction control. FOCUS_KILL_MODE is 'mute'
# (default, safer) or 'kill'. FOCUS_KILL_APPS is a comma-separated list
# of process names, only used when FOCUS_KILL_MODE=kill.
FOCUS_KILL_MODE=mute
FOCUS_KILL_APPS=Discord.exe,Spotify.exe

# Optional — expense tracker. EXPENSE_AUTO_INGEST controls whether a
# successfully-parsed WhatsApp UPI message gets logged automatically
# (true, default) or just detected and held for voice confirmation (false).
EXPENSE_AUTO_INGEST=true

# Optional — read by whatsapp_service/server.js (Node), not the Python
# backend. UPI_SENDER_PATTERNS is a comma-separated list of WhatsApp
# display-name substrings to watch for; replace with your actual bank/UPI
# app's WhatsApp name for real accuracy.
JARVIS_BACKEND_URL=http://127.0.0.1:8000
UPI_SENDER_PATTERNS=HDFC Bank,SBI,ICICI Bank,Axis Bank,Paytm,PhonePe,Google Pay

# Optional — AI model chains (comma-separated, tried in order; a model that
# is rate limited or retired is skipped automatically). Defaults are the
# models available on Groq's free tier as of Sept 2026.
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_CLASSIFIER_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b
# GROQ_VISION_MODELS=qwen/qwen3.8-27b
# GEMINI_CHAT_MODELS=gemini:gemini-3.5-flash-lite,gemini:gemini-flash-lite-latest   (fallbacks after Groq; same for GEMINI_CLASSIFIER_MODELS / GEMINI_VISION_MODELS)

# Optional — wake word sensitivity (0-1, default 0.3). Lower = wakes more
# easily but more false wakes. jarvis.py logs "wake near-miss" scores to
# help tune it for your mic.
# JARVIS_WAKE_THRESHOLD=0.4
